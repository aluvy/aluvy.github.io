;\r\n      }\r\n    }\r\n  },\r\n}\r\n&lt;/script&gt;</code><span aria-hidden=\"true\" class=\"line-numbers-rows\" style=\"white-space: normal; width: auto; left: 0;\"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span></pre></div>\n<p>month 라는 데이터가 변경될 때마다 watch 안의 month 함수가 실행된다.</p>\n<ul>\n<li>파라미터 a : 변경 후 데이터</li>\n<li>파리미터 b : 변경 전 데이터</li>\n</ul>\n<h3 id=\"문자-입력받을-시-경고하기\" style=\"position:relative;\">문자 입력받을 시 경고하기<a href=\"#%EB%AC%B8%EC%9E%90-%EC%9E%85%EB%A0%A5%EB%B0%9B%EC%9D%84-%EC%8B%9C-%EA%B2%BD%EA%B3%A0%ED%95%98%EA%B8%B0\" aria-label=\"문자 입력받을 시 경고하기 permalink\" class=\"anchor custom-class after\"><svg aria-hidden=\"true\" focusable=\"false\" height=\"16\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"16\"><path fill-rule=\"evenodd\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a></h3>\n<div class=\"gatsby-highlight\" data-language=\"vue\"><pre style=\"counter-reset: linenumber NaN\" class=\"language-vue line-numbers\"><code class=\"language-vue\">&lt;script&gt;\r\n// ...\r\nwatch: {\r\n  month(a, b){  // 감시할 데이터 이름으로 함수를 만든다. (a:변경후 데이터, b:변경 전 데이터)\r\n    if (a &gt;= 13) {\r\n      alert(&quot;경고&quot;);\r\n      this.month=b;\r\n    }\r\n    if (isNaN(a)) {\r\n      alert(&quot;문자 입력 금지&quot;);\r\n      this.month=b;\r\n    }\r\n  }\r\n},\r\n//...\r\n&lt;/script&gt;</code><span aria-hidden=\"true\" class=\"line-numbers-rows\" style=\"white-space: normal; width: auto; left: 0;\"><span></span><span></span><span></span><span></span><span></span><span></span><span